# Server Configuration
# Lưu ý: nếu file properties đang để SEVER_PORT thì giữ nguyên, nếu sửa thành SERVER_PORT thì đổi lại key này
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/booking_ota_db
DB_USERNAME=traviota
DB_PASSWORD=your_database_password_here

# JWT Configuration
# Chuỗi bí mật Base64/Hex (tối thiểu 256-bit cho thuật toán HS256)
JWT_SECRET0=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000